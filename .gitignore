# Rendu Quarto (regénéré à chaque build)
_site/
# Rendu intermédiaire du profil anglais, assemblé dans _site/en/ par scripts/rendre.py (US-36).
_site-en/

# Dépôt temporaire des sources fournies par le PO : elles sont ensuite versionnées dans
# cours/<slug>/_sources/ par l'import (US-15).
_import/
.quarto/

# CV : aucun PDF de CV n'est commité (CLAUDE.md §7, données personnelles).
# Le PDF du site est généré dans _site/cv/ depuis cv/cv.yml.
cv/*.pdf

# Python
.venv/
__pycache__/

# macOS
.DS_Store

# Note : _freeze/ est volontairement versionné (execute: freeze: auto), sauf les bibliothèques :
# _freeze/site_libs/ n'est qu'une copie des dépendances livrées avec Quarto (5 Mo pour revealjs).
# Vérifié : un rendu gelé aboutit sans ce dossier, et sans Python installé (US-18).
_freeze/site_libs/

/.quarto/
node_modules/

# Rendu d'un fichier isolé : Quarto écrit alors la page à côté de sa source (cv/index.html,
# cv/index_files/…). Ces fichiers ne sont pas des sources : le site se rend avec scripts/rendre.py.
**/index.html
**/*_files/
**/*.quarto_ipynb
